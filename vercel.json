{
  "version": 2,
  "buildCommand": "npm ci && npm run build --workspace=@urfmp/web",
  "outputDirectory": "web/dist",
  "installCommand": "echo 'Dependencies installed in buildCommand'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
