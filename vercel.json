{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel --workspace=@urfmp/web",
  "outputDirectory": "web/dist",
  "framework": null,
  "build": {
    "env": {
      "VITE_DEMO_MODE": "true"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
