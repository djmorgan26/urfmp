# Production Environment Configuration
# IMPORTANT: Override these in Vercel dashboard with your actual deployed API URL

# Brand Configuration
VITE_COMPANY_NAME=URFMP
VITE_PRODUCT_NAME=URFMP
VITE_PRODUCT_FULL_NAME=Universal Robot Fleet Management Platform
VITE_TAGLINE=The Stripe of Robotics
VITE_DESCRIPTION=Monitor any robot in 7 lines of code

# Production Mode - Connect to Railway Backend
VITE_DEMO_MODE=false

# Railway Production API
VITE_URFMP_API_URL=https://urfmpapi-production.up.railway.app
VITE_URFMP_WS_URL=wss://urfmpapi-production.up.railway.app/ws

# Note: This file is used automatically by Vite when building for production
# Local development still uses .env (localhost:3000)
