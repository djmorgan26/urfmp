# Production Environment Configuration
# IMPORTANT: Override these in Vercel dashboard with your actual deployed API URL

# Brand Configuration
VITE_COMPANY_NAME=URFMP
VITE_PRODUCT_NAME=URFMP
VITE_PRODUCT_FULL_NAME=Universal Robot Fleet Management Platform
VITE_TAGLINE=The Stripe of Robotics
VITE_DESCRIPTION=Monitor any robot in 7 lines of code

# Production Mode - Set in Vercel dashboard
# Option 1: Demo mode (no backend needed)
VITE_DEMO_MODE=false

# Option 2: Real backend (update with your Render.com API URL after deployment)
VITE_URFMP_API_URL=https://urfmp-api.onrender.com
VITE_URFMP_WS_URL=wss://urfmp-api.onrender.com/ws

# Instructions:
# 1. Deploy API to Render.com using render.yaml
# 2. Get your API URL from Render dashboard
# 3. Set these environment variables in Vercel:
#    - VITE_DEMO_MODE=false
#    - VITE_URFMP_API_URL=https://your-api-url.onrender.com
#    - VITE_URFMP_WS_URL=wss://your-api-url.onrender.com/ws
# 4. Redeploy Vercel
