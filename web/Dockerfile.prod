# Production Web Frontend Dockerfile
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY web/package*.json ./web/
COPY packages/types/package*.json ./packages/types/
COPY packages/sdk/package*.json ./packages/sdk/

# Install dependencies
RUN npm ci --only=production && npm cache clean --force

# Build stage
FROM base AS builder
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY web/package*.json ./web/
COPY packages/types/package*.json ./packages/types/
COPY packages/sdk/package*.json ./packages/sdk/

# Install all dependencies (including dev dependencies)
RUN npm ci

# Copy source code
COPY . .

# Build types package first
RUN npm run build --workspace=@urfmp/types

# Build SDK package
RUN npm run build --workspace=@urfmp/sdk

# Build web application
RUN cd web && npm run build

# Production stage - Use nginx to serve the built files
FROM nginx:alpine AS runner

# Copy built application from builder stage
COPY --from=builder /app/web/dist /usr/share/nginx/html

# Copy nginx configuration
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S urfmp -u 1001

# Change ownership of nginx directories
RUN chown -R urfmp:nodejs /var/cache/nginx && \
    chown -R urfmp:nodejs /var/log/nginx && \
    chown -R urfmp:nodejs /etc/nginx/conf.d
RUN touch /var/run/nginx.pid && \
    chown -R urfmp:nodejs /var/run/nginx.pid

USER urfmp

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]